{
  "name": "echo-frontend",
  "version": "0.1.0",
  "private": true,
  "description": "ECHO hotel review intelligence frontend (panel + shared packages)",
  "scripts": {
    "dev": "pnpm --filter echo-panel dev",
    "dev:clean": "pnpm kill-port && pnpm dev",
    "kill-port": "lsof -ti :5173 2>/dev/null | xargs -r kill -9 2>/dev/null; echo 'port 5173 freed'",
    "build": "pnpm -r build",
    "start": "pnpm --filter echo-panel start",
    "lint": "eslint . --max-warnings 0",
    "check": "pnpm -r check",
    "test": "pnpm --filter echo-panel test"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "eslint-plugin-svelte": "^3.22.0",
    "globals": "^16.5.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.65.0"
  },
  "engines": {
    "node": ">=22.13.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@11.1.2"
}
